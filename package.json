{
  "name": "@beforesemicolon/cube",
  "version": "0.2.0",
  "description": "Function-oriented framework to create future-proof UI components and web applications.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "local": "nodemon --watch src -e ts --exec 'tsc && npm-run-all build:min build:client build:client-router build:client-store build:client-intl'",
    "server": "nodemon --watch server --exec 'node server'",
    "docs:css-watch": "nodemon --watch docs-src -e scss --exec 'npm run docs:css'",
    "docs:css": "node-sass docs-src/stylesheets -o docs/stylesheets --output-style compressed",
    "docs:watch": "rm -rf docs && nodemon --watch docs-src -e ts,json --exec 'npm run docs:build'",
    "docs:build": "ts-node docs-src/build",
    "build:docs": "rm -rf docs && npm-run-all docs:build docs:css",
    "build:min": "esbuild `find src \\( -name '*.ts' ! -name '*.spec.ts' \\)` --outdir=dist --platform=node --format=cjs --keep-names --minify --target=esNext",
    "build:client": "esbuild src/client.ts --bundle --minify --keep-names --sourcemap --target=esNext --outfile=dist/client.js",
    "build:client-router": "esbuild src/client-router.ts --bundle --minify --keep-names --sourcemap --target=esNext --outfile=dist/client-router.js",
    "build:client-store": "esbuild src/client-store.ts --bundle --minify --keep-names --sourcemap --target=esNext --outfile=dist/client-store.js",
    "build:client-intl": "esbuild src/client-intl.ts --bundle --minify --keep-names --sourcemap --target=esNext --outfile=dist/client-intl.js",
    "build": "npm-run-all lint test && rm -rf dist && tsc && npm-run-all build:min build:client build:client-router build:client-store build:client-intl",
    "lint": "eslint ./src && prettier --check ./src",
    "format": "eslint ./src --fix && prettier --write ./src"
  },
  "keywords": [],
  "author": "",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@beforesemicolon/html-parser": "*",
    "@types/express": "^4.17.17",
    "@types/highlight.js": "^10.1.0",
    "@types/jest": "^29.5.11",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "core-js": "^3.31.0",
    "csstype": "^3.1.2",
    "esbuild": "^0.28.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.5.0",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-promise": "^6.1.1",
    "express": "^5.2.1",
    "global-jsdom": "^25.0.0",
    "highlight.js": "^11.12.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^25.0.1",
    "node-sass": "^9.0.0",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "prettier": "3.9.6",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@beforesemicolon/web-component": "^1.21.0"
  }
}
