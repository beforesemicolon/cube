  "files": [
    "dist/esm/**/*.js",
    "dist/cjs/**/*.js",
    "dist/cjs/package.json",
    "dist/types/**/*.d.ts",
    "dist/client.js",
    "dist/*-client.js",
    "dist/themes/*.css",
    "dist/themes/*.json",
    "dist/icons/*.svg",
    "dist/icons/*.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./components/index.ts",
    "./components/**/index.ts",
    "./dist/esm/index.js",
    "./dist/esm/**/index.js",
    "./dist/cjs/index.js",
    "./dist/cjs/**/index.js",
    "./stories/setup.ts",
    "./components/core/browser.ts",
    "./components/client.ts",
    "./components/*-client.ts",
    "./components/icons/registry.ts",
    "./dist/client.js",
    "./dist/*-client.js",
    "./dist/esm/icons/registry.js",
    "./dist/cjs/icons/registry.js"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.contracts.json",
    "test": "tsc -p tsconfig.unit.json && node --test .test-output/tests/*.spec.js",
    "build": "tsx scripts/build.ts",
    "build:package": "npm run typecheck && npm test && npm run build",
    "storybook": "storybook dev -p 6006",
    "start": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:catalog": "tsx scripts/check-catalog.ts",
    "test:visual-audit": "tsx scripts/capture-design-qa.ts",
    "test:storybook-visuals": "tsx scripts/capture-storybook-visuals.ts",
    "test:browser": "playwright test",
    "dev": "vite --host 127.0.0.1",
    "test:exports": "tsx scripts/check-exports.ts",
    "test:pack": "tsx scripts/check-package.ts",
    "audit:runtime": "npm audit --omit=dev",
    "verify:release": "npm run build:package && npm run test:exports && npm run build:storybook && npm run test:catalog && npm run build:docs && npm run test:browser && npm run audit:runtime && npm run test:pack",
    "prepack": "npm run build:package && npm run test:exports",
    "prepublishOnly": "npm run verify:release",
    "build:docs": "tsx scripts/build-docs.ts",
    "build:site": "npm run build && npm run build:docs && npm run build:storybook -- --output-dir website/playground",
    "preview:site": "tsx scripts/preview-site.ts"
  },
  "dependencies": {
    "@beforesemicolon/web-component": "^1.21.1",
    "echarts": "6.1.0",
    "highlight.js": "^11.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/parser": "^8.0.7",
    "@babel/types": "^8.0.6",
    "@beforesemicolon/builder": "^2.0.1",
    "@beforesemicolon/site-builder": "^1.15.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/web-components-vite": "^10.6.2",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "lit": "^3.3.3",
    "storybook": "^10.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/beforesemicolon/cube.git"
  }
