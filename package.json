{
  "name": "@beforesemicolon/cube",
  "version": "0.1.7",
  "description": "Function-oriented framework to create future-proof UI components and web applications.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "watch:docs": "nodemon --watch docs/documentation/articles -e html --exec 'npm run build:docs'",
    "build:docs": "node ./scripts/build-docs.js",
    "build:min": "esbuild `find src \\( -name '*.ts' ! -name '*.spec.ts' \\)` --outdir=dist --platform=node --format=cjs --keep-names --minify --target=esnext\n",
    "build:browser": "esbuild src/client.ts --bundle --minify --keep-names --sourcemap --target=esnext --outfile=dist/client.js",
    "build:browser-module": "esbuild src/index.ts --bundle --minify --keep-names --sourcemap --target=esnext --outfile=dist/client-module.js",
    "build": "npm-run-all test build:docs && rm -rf dist && tsc && npm-run-all build:min build:browser"
  },
  "keywords": [],
  "author": "",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@beforesemicolon/html-parser": "^0.2.2",
    "@types/jest": "^29.5.1",
    "@types/jsdom": "^21.1.1",
    "@types/node": "^20.1.0",
    "core-js": "^3.31.0",
    "esbuild": "^0.17.18",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "jsdom": "^22.1.0",
    "nodemon": "^2.0.22",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@beforesemicolon/html": "^0.1.15"
  }
}
