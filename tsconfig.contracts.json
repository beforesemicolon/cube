{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "components/**/*.spec.ts",
    "tests/component-contract.ts",
    "tests/browser/package-styles.spec.ts",
    "scripts/check-package.ts",
    ".storybook/main.ts",
    "types/css.d.ts"
  ]
}
