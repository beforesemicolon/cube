{
  "schemaVersion": "1.0",
  "mode": "static",
  "siteUrl": "https://cube.beforesemicolon.com",
  "deployment": {
    "targets": {
      "cloudflareWorkers": {
        "name": "cube",
        "compatibilityDate": "2026-08-11"
      }
    }
  },
  "defaultLocale": "en",
  "locales": ["en", "pt", "es", "fr", "zh"],
  "localeDetails": {
    "en": { "label": "English", "selectorLabel": "Choose language" },
    "pt": { "label": "Português", "selectorLabel": "Escolher idioma" },
    "es": { "label": "Español", "selectorLabel": "Elegir idioma" },
    "fr": { "label": "Français", "selectorLabel": "Choisir la langue" },
    "zh": { "label": "中文", "selectorLabel": "选择语言" }
  },
  "document": {
    "analytics": {
      "providers": [
        {
          "type": "google-analytics",
          "tagId": "G-F92VLFRYR5",
          "enabled": true,
          "config": { "send_page_view": true }
        }
      ]
    },
    "csp": {
      "style-src": ["'self'", "https://fonts.googleapis.com"],
      "style-src-attr": ["'unsafe-inline'"],
      "font-src": ["'self'", "data:", "https://fonts.gstatic.com"]
    },
    "scripts": [
      { "src": "/assets/cube/web-component.js", "defer": true },
      { "src": "/assets/cube/client.js", "defer": true },
      { "src": "/assets/cube/examples.js", "defer": true }
    ]
  },
  "docs": {
    "sourceDir": ".",
    "outputDir": "../website",
    "template": "fading-citrus",
    "generatedFiles": {
      "llms": true,
      "llmsFull": true,
      "netlify": false
    }
  }
}
